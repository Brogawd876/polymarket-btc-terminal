# Local server
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
EXTENSION_ID=jkpghfeaioigocjjdfeeocfjilhjbdno
WS_AUTH_TOKEN=replace_with_at_least_24_random_characters
POLYMARKET_DATA_DIR=./apps/server/data
POLYMARKET_RUNTIME_DIR=./runtime

# Live execution is opt-in and starts disarmed
ENABLE_LIVE_TRADING=false
PRIVATE_KEY=
POLY_FUNDER_ADDRESS=
POLY_SIGNATURE_TYPE=3
POLY_API_KEY_NONCE=0

# Market discovery and reference
MARKET_FAMILY=btc-up-or-down-5m
MARKET_SLUG_PREFIX=btc-updown-5m
MARKET_SLOT_MS=300000
CHAINLINK_RTDS_URL=wss://ws-live-data.polymarket.com

# Readiness and risk
MIN_TIME_REMAINING_MS=10000
MAX_MARKET_DATA_AGE_MS=3000
MAX_REFERENCE_DATA_AGE_MS=5000
MAX_SINGLE_BUY_USD=100
MAX_OPEN_EXPOSURE_USD=500
MAX_POSITION_SHARES=1000
MAX_OPEN_ORDERS=20
MAX_SESSION_LOSS=10
MAX_SESSION_PROFIT=150
MAX_FAK_SLIPPAGE_BPS=200

# Optional RPC fallback for balance diagnostics
POLYGON_RPC_URL=https://polygon.drpc.org
