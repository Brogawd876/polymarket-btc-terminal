# Runtime
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
DATABASE_PATH=./data/terminal.sqlite
LOG_LEVEL=info

WS_AUTH_TOKEN=

# Operation
DEFAULT_MODE=PAPER
ENABLE_LIVE_TRADING=false
REQUIRE_LIVE_ENABLE_CLICK=true

# Polymarket wallet
PRIVATE_KEY=
DEPOSIT_WALLET_ADDRESS=
SIGNATURE_TYPE=3
API_KEY_NONCE=0

# Optional persisted API credentials
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Optional builder credentials
BUILDER_API_KEY=
BUILDER_API_SECRET=
BUILDER_API_PASSPHRASE=

# Market
MARKET_FAMILY=btc-updown-5m
CHAIN_ID=137

# Default references
BUY_REFERENCE=BEST_BID
SELL_REFERENCE=BEST_ASK

# Dynamic maker presets
BUY_PRESETS=percent:15,percent:20,percent:50
SELL_PRESETS=percent:15,percent:20,percent:50

# Maker-order behavior
POST_ONLY=true
MAKER_CROSSING_BEHAVIOR=CLAMP
DEFAULT_LIMIT_TIF=GTD
CANCEL_SECONDS_BEFORE_END=10

# Size presets
BUY_SIZE_PRESETS=10,25,50,100
SELL_SIZE_PERCENT_PRESETS=25,50,100

# Operational controls
MAX_SINGLE_BUY_USD=100
MAX_OPEN_EXPOSURE_USD=250
MAX_SESSION_LOSS=100
MAX_SESSION_PROFIT=200
MIN_SECONDS_REMAINING=10
STALE_MARKET_DATA_MS=3000
STALE_REFERENCE_DATA_MS=3000
MAX_IMMEDIATE_ORDER_SLIPPAGE_BPS=300

# Paper simulation
PAPER_LATENCY_MS=150
PAPER_USE_LIVE_BOOK=true

# Tests
RUN_LIVE_SMOKE=false
LIVE_SMOKE_MAX_USD=1
