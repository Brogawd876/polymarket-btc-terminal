{
  "name": "polymarket-btc5m-terminal",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:server": "pnpm --filter server dev",
    "dev:extension": "pnpm --filter extension dev",
    "build": "pnpm -r build && pnpm package:extension",
    "build:server": "pnpm --filter server build",
    "build:extension:chrome": "pnpm --filter extension build:chrome",
    "build:extension:firefox": "pnpm --filter extension build:firefox",
    "package:extension": "pnpm --filter extension package",
    "start:prod": "pnpm --filter server start:prod",
    "lint": "pnpm --parallel --filter \"*\" lint",
    "typecheck": "pnpm --parallel --filter \"*\" typecheck",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test tests/e2e",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build:server && pnpm build:extension:chrome && pnpm package:extension && pnpm test:e2e",
    "public:diagnose": "pnpm --filter server public:diagnose",
    "live:diagnose": "pnpm --filter server live:diagnose",
    "live:smoke": "pnpm --filter server live:smoke",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:reset:test": "pnpm --filter server db:reset:test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ws": "8.16.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@fastify/cors": "8.5.0",
    "@fastify/websocket": "8.3.1",
    "@playwright/test": "1.44.0",
    "@types/node": "20.12.12",
    "@types/ws": "8.5.10",
    "better-sqlite3": "11.3.0",
    "fastify": "4.26.1",
    "typescript": "5.4.5",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
